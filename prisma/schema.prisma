generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  isAdmin   Boolean   @default(false)
  isVerified Boolean  @default(false)
  verificationCode String?
  verificationExpires DateTime?
  passwordHash String?
  createdAt DateTime  @default(now())
  accounts  Account[]
  sessions  Session[]
  requestsMade Request[] @relation("requests_made")
  requestsReceived Request[] @relation("requests_received")
  deletedTransactions Transaction[] @relation("TransactionDeletedByUser")
}

model Account {
  id            Int           @id @default(autoincrement())
  name          String
  balanceCents  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  userId        Int
  user          User          @relation(fields: [userId], references: [id])
  transactions  Transaction[]
}

model Transaction {
  id           Int              @id @default(autoincrement())
  account      Account          @relation(fields: [accountId], references: [id])
  accountId    Int
  type         String
  amountCents  Int
  description  String?
  balanceAfterCents Int
  source       String?
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  deletedByUserId Int?
  deletedByUser User?          @relation("TransactionDeletedByUser", fields: [deletedByUserId], references: [id])
  deletionReason String?
}

model Request {
  id                 Int      @id @default(autoincrement())
  requesterId        Int
  requester          User     @relation("requests_made", fields: [requesterId], references: [id])
  targetUserId       Int
  targetUser         User     @relation("requests_received", fields: [targetUserId], references: [id])
  amountCents        Int
  type               String   // DEMAND or LOAN
  status             String   // PENDING, ACCEPTED, REJECTED
  description        String?
  dueAt              DateTime
  lastPenaltyAt      DateTime?
  penaltyAccruedCents Int     @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  acceptedAt         DateTime?
  rejectedAt         DateTime?
}

model Session {
  token     String   @id
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
}
